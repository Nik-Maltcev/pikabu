# ===========================================
# BizMap VPS Environment Variables
# ===========================================
# Скопируй этот файл: cp .env.example .env
# Заполни значениями из Railway

# --- Postgres (новый пароль для VPS) ---
POSTGRES_PASSWORD=придумай-сложный-пароль-тут

# --- LLM ---
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-...ваш-ключ-из-railway...
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_MAX_RETRIES=3
LLM_CONTEXT_WINDOW=131072
LLM_MAX_TOKENS_CHUNK=16384
LLM_MAX_TOKENS_AGGREGATION=16384
LLM_CHUNK_SIZE=100000

GEMINI_API_KEY=...из-railway...
GEMINI_MODEL=gemini-2.5-flash

GLM_API_KEY=...из-railway...

# --- Pikabu прокси ---
PIKABU_PROXY_URL=socks5://user:pass@host:port

# --- Robokassa ---
ROBOKASSA_LOGIN=...из-railway...
ROBOKASSA_PASSWORD1=...из-railway...
ROBOKASSA_PASSWORD2=...из-railway...
ROBOKASSA_TEST_MODE=false
SITE_URL=https://www.bizmap.space

# --- Auth ---
JWT_SECRET=...из-railway...

# --- CORS ---
CORS_ORIGINS=https://www.bizmap.space,https://bizmap.space

# --- Cron ---
CRON_SECRET=...из-railway...
MAX_CONCURRENT_ANALYSES=5

# --- Frontend ---
VITE_API_URL=https://api.bizmap.space

# --- Email ---
RESEND_API_KEY=...из-railway...

# --- Market Data ---
SERPAPI_KEY=...из-railway...
LINKUP_API_KEY=...из-railway...
